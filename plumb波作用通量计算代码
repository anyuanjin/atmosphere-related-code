import numpy as np
import xarray as xr
ds_u=xr.open_dataset(r"D:\Ashuju\uwnd.mon.mean.nc")
ds_v=xr.open_dataset(r"D:\Ashuju\vwnd.mon.mean.nc")
ds_hgt=xr.open_dataset(r"E:\micorftdowanload\hgt.mon.mean (5).nc")

def fuc(x):
    x=x.sel(time=slice('1981-01-01','2004-12-01'))
    x=x.sel(time=x.time.dt.month.isin([5,6,7,8,9]))
    x=x.groupby(x.time.dt.year)
    x=x.mean(dim='time')
    return x

ds_u=fuc(ds_u)
ds_v=fuc(ds_v)
ds_hgt=fuc(ds_hgt)*9.8
#现在的两个文件对应24长度的序列
urao=ds_u-ds_u.mean(dim='year')
vrao=ds_v-ds_v.mean(dim='year')
hgtrao=ds_hgt-ds_hgt.mean(dim='year')
a=6371000
P0=1000
omega=7.292e-5
urao=urao['uwnd']
vrao=vrao['vwnd']
hgtrao=hgtrao['hgt']
Fx=((ds_u['level']/P0)*np.cos(np.deg2rad(ds_u['lat'])))*(vrao**2-((vrao*hgtrao).differentiate('lon')*180/np.pi)/(2*omega*a*np.sin(np.deg2rad(2*ds_u['lat']))))
Fy=((ds_u['level']/P0)*np.cos(np.deg2rad(ds_u['lat'])))*(-vrao*urao+((urao*hgtrao).differentiate('lon')*180/np.pi)/(2*omega*a*np.sin(np.deg2rad(2*ds_u['lat']))))
